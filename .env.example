# HuggingFace sentence-transformers model id
EMBED_MODEL=sentence-transformers/all-mpnet-base-v2

# Shared secret required on POST /embed via the X-API-Key header. Must match
# ML_API_KEY in the Vercel project. Leave unset locally to skip the check.
# Generate: openssl rand -hex 32
ML_API_KEY=

# Port — Railway sets this automatically in prod
PORT=8000
